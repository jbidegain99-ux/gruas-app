{
  "name": "gruas-app",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "dev:mobile": "pnpm --filter mobile start",
    "build:mobile": "pnpm --filter mobile export",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo:reset": "node scripts/demo.mjs reset",
    "demo:status": "node scripts/demo.mjs status",
    "demo:ping": "node scripts/demo.mjs ping",
    "demo:drive": "node scripts/demo.mjs drive",
    "demo:code": "node scripts/demo.mjs code",
    "demo:up": "node scripts/demo-env.mjs up",
    "demo:fresh": "node scripts/demo-env.mjs fresh",
    "demo:down": "node scripts/demo-env.mjs down",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:test": "node scripts/db-test.mjs",
    "dev:accounts": "node scripts/dev-accounts.mjs",
    "qa:cycle": "node scripts/qa-cycle.mjs",
    "db:seed": "supabase db seed",
    "db:types": "supabase gen types typescript --linked --schema public > packages/shared/src/database.types.ts",
    "db:types:local": "supabase gen types typescript --local --schema public | npx -y prettier@3 --no-semi --parser typescript > packages/shared/src/database.types.ts"
  }
}
