# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Default location fallback (used before GPS resolves / when coords missing).
# Defaults to San Salvador, El Salvador if unset. See config/location.ts.
# EXPO_PUBLIC_DEFAULT_LAT=13.6929
# EXPO_PUBLIC_DEFAULT_LNG=-89.2182
# EXPO_PUBLIC_DEFAULT_MAP_DELTA=0.02

# Soporte (APP-07): sin estos, la app no ofrece esos canales. Nada de números de relleno.
# EXPO_PUBLIC_SUPPORT_PHONE=+503XXXXXXXX
# EXPO_PUBLIC_SUPPORT_WHATSAPP=503XXXXXXXX
