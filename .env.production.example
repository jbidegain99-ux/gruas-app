# Template for the PRODUCTION env. Copy to .env.production on the VPS
# (or whatever path your secrets manager points at). NEVER commit the
# filled-in file — .env.production is already in .gitignore via .env.*.
#
# Compared to .env.example (dev), production:
#   - Points at the production Supabase URL, not localhost / dev project
#   - Uses real (not demo) Maps and WhatsApp keys
#   - Has restricted CORS (set on the Supabase side / edge functions)
#   - Service role key must live ONLY here, never in client builds
#
# Mobile envs (EXPO_PUBLIC_*) below are listed for reference. They do
# NOT go on the VPS — they get baked into the Expo binary at build time
# via EAS secrets, NOT pulled at runtime from the server.

# ── Supabase (web server + edge functions) ────────────────────────────
# Public, safe to ship to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROD-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PROD-ANON-KEY

# Server-only. Bypasses RLS. NEVER expose with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR-PROD-SERVICE-ROLE-KEY

# ── Google Maps ───────────────────────────────────────────────────────
# Restrict by HTTP referrer in Google Cloud Console to your prod domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR-PROD-MAPS-KEY-RESTRICTED-TO-DOMAIN

# ── WhatsApp Cloud API ────────────────────────────────────────────────
WHATSAPP_TOKEN=YOUR-PROD-WHATSAPP-PERMANENT-TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR-PROD-PHONE-NUMBER-ID
MOP_WHATSAPP_TO=503XXXXXXXX

# ── Runtime ───────────────────────────────────────────────────────────
NODE_ENV=production
# PORT and HOSTNAME are set in the Dockerfile; override here if needed.

# ── Observability: Sentry (web) ───────────────────────────────────────
# Wiring lives in apps/web/instrumentation.ts and instrumentation-client.ts.
# Without these vars the SDK is a no-op (safe default).
#
# Public DSN: shipped to the browser; only allows event ingestion.
NEXT_PUBLIC_SENTRY_DSN=
# Optional sample rates (defaults: 0.1).
# NEXT_PUBLIC_SENTRY_TRACES_RATE=0.1
# SENTRY_TRACES_RATE=0.1
#
# Build-time only (CI / VPS build host). Lets the build upload source
# maps to Sentry. Get a token at:
#   https://sentry.io/settings/account/api/auth-tokens/  (scope: project:releases + project:write)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Edge Functions (Supabase Dashboard → Edge Functions → Secrets) ────
# These do NOT belong in the VPS .env.production — they're set per-project
# on Supabase. Listed here as a reminder of what needs to be configured
# alongside the web deploy:
#
#   ALLOWED_ORIGINS=https://app.budi.sv
#       Comma-separated list of origins the Edge Functions accept via
#       CORS. Mobile fetch doesn't send Origin, so this only affects
#       browser callers (the web app). Default "*" if unset.
#
#   GOOGLE_MAPS_API_KEY=...
#       Used by calculate-distance and get-eta. Restrict by HTTP referrer
#       in Google Cloud Console.
#
#   WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, MOP_WHATSAPP_TO
#       Used by notify-mop-whatsapp.
#
# Set via:
#   supabase secrets set ALLOWED_ORIGINS=https://app.budi.sv --project-ref qmjpotnmiusxyfujhdqp

# ── Mobile (NOT on the VPS — kept here as a reminder) ─────────────────
# These go into EAS secrets, not into the server env. They are baked
# into the Expo build at compile time. Listed so you don't forget.
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROD-PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PROD-ANON-KEY
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR-PROD-MAPS-KEY-RESTRICTED-TO-BUNDLE-ID
# EXPO_PUBLIC_SENTRY_DSN=YOUR-MOBILE-SENTRY-DSN
# EXPO_PUBLIC_SENTRY_TRACES_RATE=0.1
# SENTRY_AUTH_TOKEN  (also for mobile native builds via EAS secrets)
